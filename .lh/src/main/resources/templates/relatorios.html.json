                    "date": 1761460932750,
                    "content": "Index: \n===================================================================\n--- \n+++ \n@@ -0,0 +1,70 @@\n+<!DOCTYPE html>\n+<html lang=\"pt-br\" xmlns:th=\"http://www.thymeleaf.org\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <title>Relatórios - EpiControl</title>\n+    <link\n+      rel=\"stylesheet\"\n+      href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\"\n+    />\n+    <link rel=\"stylesheet\" th:href=\"@{/css/layout-sidebar.css}\" />\n+    <link rel=\"stylesheet\" th:href=\"@{/css/relatorios.css}\" />\n+  </head>\n+  <body>\n+    <div class=\"app-container\">\n+      <div\n+        th:replace=\"~{fragments/layout :: sidebar(activePage='relatorios')}\"\n+      ></div>\n+      <main class=\"main-content\">\n+        <div class=\"page-header\">\n+          <h1>Relatório por Colaborador</h1>\n+        </div>\n+\n+        <!-- Formulário de Pesquisa -->\n+        <div class=\"search-container\">\n+          <form th:action=\"@{/relatorios}\" method=\"get\" class=\"search-form\">\n+            <input\n+              type=\"text\"\n+              name=\"query\"\n+              placeholder=\"Pesquisar por nome ou RE do colaborador...\"\n+              class=\"search-input\"\n+              th:value=\"${query}\"\n+            />\n+            <button type=\"submit\" class=\"btn btn-primary\">\n+              <i class=\"fas fa-search\"></i> Pesquisar\n+            </button>\n+          </form>\n+        </div>\n+\n+        <!-- Resultados da Pesquisa (Exemplo) -->\n+        <div class=\"results-container\" th:if=\"${colaboradorEncontrado}\">\n+          <h2 th:text=\"'Entregas para: ' + ${colaboradorEncontrado}\"></h2>\n+          <div class=\"table-container\">\n+            <table>\n+              <thead>\n+                <tr>\n+                  <th>EPI</th>\n+                  <th>Quantidade</th>\n+                  <th>Data da Entrega</th>\n+                </tr>\n+              </thead>\n+              <tbody>\n+                <!-- Dados de exemplo -->\n+                <tr><td>Capacete de Segurança</td><td>1</td><td>15/09/2025</td></tr>\n+                <tr><td>Luva de Proteção</td><td>2</td><td>15/09/2025</td></tr>\n+                <tr><td>Bota de Segurança</td><td>1</td><td>10/08/2025</td></tr>\n+              </tbody>\n+            </table>\n+          </div>\n+        </div>\n+\n+        <!-- Mensagem de \"nenhum resultado\" -->\n+        <div class=\"results-container\" th:if=\"${notFound}\">\n+          <p>Nenhum colaborador encontrado com o termo pesquisado.</p>\n+        </div>\n+      </main>\n+    </div>\n+    <script th:src=\"@{/js/layout.js}\"></script>\n+  </body>\n+</html>\n\\ No newline at end of file\n"
