                    "content": "Index: \n===================================================================\n--- \n+++ \n@@ -0,0 +1,84 @@\n+<!DOCTYPE html>\n+<html lang=\"pt-br\" xmlns:th=\"http://www.thymeleaf.org\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <!-- Ícones do Font Awesome -->\n+    <link\n+      rel=\"stylesheet\"\n+      href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\"\n+    />\n+    <title>Dashboard - EpiControl</title>\n+    <!-- CSS do Layout Principal -->\n+    <link rel=\"stylesheet\" th:href=\"@{/css/layout-sidebar.css}\" />\n+    <!-- CSS Específico do Dashboard -->\n+    <link rel=\"stylesheet\" th:href=\"@{/css/dashboard-cards.css}\" />\n+  </head>\n+  <body>\n+    <div class=\"app-container\">\n+      <!-- Importa a sidebar, passando 'dashboard' como a página ativa -->\n+      <div\n+        th:replace=\"~{fragments/layout :: sidebar(activePage='dashboard')}\"\n+      ></div>\n+\n+      <!-- Conteúdo Principal -->\n+      <main class=\"main-content\">\n+        <h1>Dashboard</h1>\n+\n+        <div class=\"dashboard-grid\">\n+          <div class=\"card\">\n+            <h3>Resumo do Estoque</h3>\n+            <ul id=\"resumo-estoque-list\">\n+              <li>\n+                Estoque Baixo:\n+                <strong id=\"tipos-estoque-baixo\">...</strong>\n+              </li>\n+              <li>\n+                <a th:href=\"@{/epis(filtro=vencendo)}\" class=\"dashboard-link\"\n+                  >Vencendo (30 dias):</a\n+                >\n+                <strong id=\"epis-vencendo\">...</strong>\n+              </li>\n+              <li>\n+                <a th:href=\"@{/epis(filtro=em-falta)}\" class=\"dashboard-link\"\n+                  >Em falta:</a\n+                >\n+                <strong id=\"epis-em-falta\">...</strong>\n+              </li>\n+            </ul>\n+          </div>\n+\n+          <div class=\"card alert-card\">\n+            <h3>Alertas</h3>\n+            <ul id=\"alertas-list\">\n+              <li>\n+                Colaboradores sem EPI:\n+                <strong id=\"colaboradores-sem-epi\">...</strong>\n+              </li>\n+              <li>\n+                Entregas vencidas: <strong id=\"entregas-vencidas\">...</strong>\n+              </li>\n+            </ul>\n+          </div>\n+        </div>\n+\n+        <!-- Seção de Gráficos -->\n+        <div class=\"charts-section\">\n+          <div class=\"card card-chart\">\n+            <h3>EPIs Mais Utilizados</h3>\n+            <canvas id=\"episMaisUtilizadosChart\"></canvas>\n+          </div>\n+          <div class=\"card card-chart\">\n+            <h3>Uso de EPIs por Setor</h3>\n+            <canvas id=\"usoPorSetorChart\"></canvas>\n+          </div>\n+        </div>\n+      </main>\n+    </div>\n+\n+    <!-- Scripts -->\n+    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n+    <script th:src=\"@{/js/layout.js}\"></script>\n+    <!-- <script th:src=\"@{/js/dashboard.js}\"></script> -->\n+  </body>\n+</html>\n\\ No newline at end of file\n"
