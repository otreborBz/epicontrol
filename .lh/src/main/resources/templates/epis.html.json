                    "date": 1761460585741,
                    "content": "Index: \n===================================================================\n--- \n+++ \n@@ -0,0 +1,80 @@\n+<!DOCTYPE html>\n+<html lang=\"pt-br\" xmlns:th=\"http://www.thymeleaf.org\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <!-- Ícones do Font Awesome -->\n+    <link\n+      rel=\"stylesheet\"\n+      href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\"\n+    />\n+    <title>EPIs - EpiControl</title>\n+    <!-- CSS do Layout Principal -->\n+    <link rel=\"stylesheet\" th:href=\"@{/css/layout-sidebar.css}\" />\n+    <!-- CSS Específico da Página -->\n+    <link rel=\"stylesheet\" th:href=\"@{/css/epis.css}\" />\n+  </head>\n+  <body>\n+    <div class=\"app-container\">\n+      <!-- Importa a sidebar, passando 'epis' como a página ativa -->\n+      <div th:replace=\"~{fragments/layout :: sidebar(activePage='epis')}\"></div>\n+\n+      <main class=\"main-content\">\n+        <div class=\"page-header\">\n+          <h1>Gestão de EPIs</h1>\n+          <button id=\"open-modal-btn\" class=\"btn btn-primary\">\n+            <i class=\"fas fa-plus\"></i> Novo EPI\n+          </button>\n+        </div>\n+\n+        <!-- Tabela de EPIs -->\n+        <div class=\"table-container\">\n+          <table>\n+            <thead>\n+              <tr>\n+                <th>Nome</th>\n+                <th>CA</th>\n+                <th>Validade</th>\n+                <th>Quantidade</th>\n+                <th>Ações</th>\n+              </tr>\n+            </thead>\n+            <tbody>\n+              <!-- Exemplo de linha - será populado dinamicamente -->\n+              <tr>\n+                <td>Luva de Proteção</td>\n+                <td>98765</td>\n+                <td>01/12/2026</td>\n+                <td>50</td>\n+                <td class=\"actions\">\n+                  <a href=\"#\" title=\"Editar\"><i class=\"fas fa-edit\"></i></a>\n+                  <a href=\"#\" title=\"Excluir\"><i class=\"fas fa-trash\"></i></a>\n+                </td>\n+              </tr>\n+            </tbody>\n+          </table>\n+        </div>\n+      </main>\n+    </div>\n+\n+    <!-- Modal para Novo EPI -->\n+    <div id=\"epi-modal\" class=\"modal\">\n+      <div class=\"modal-content\">\n+        <div class=\"modal-header\">\n+          <h2>Novo EPI</h2>\n+          <button id=\"close-modal-btn\" class=\"close-button\">&times;</button>\n+        </div>\n+        <form action=\"/epis/novo\" method=\"post\" class=\"modal-form\">\n+          <div class=\"form-group\"><label for=\"nome\">Nome do EPI</label><input type=\"text\" id=\"nome\" name=\"nome\" required /></div>\n+          <div class=\"form-group\"><label for=\"ca\">CA (Certificado de Aprovação)</label><input type=\"text\" id=\"ca\" name=\"ca\" required /></div>\n+          <div class=\"form-group\"><label for=\"validade\">Validade</label><input type=\"date\" id=\"validade\" name=\"validade\" required /></div>\n+          <div class=\"form-group\"><label for=\"quantidade\">Quantidade em Estoque</label><input type=\"number\" id=\"quantidade\" name=\"quantidade\" required /></div>\n+          <div class=\"form-actions\"><button type=\"submit\" class=\"btn btn-primary\">Salvar</button></div>\n+        </form>\n+      </div>\n+    </div>\n+\n+    <script th:src=\"@{/js/layout.js}\"></script>\n+    <script th:src=\"@{/js/epis.js}\"></script>\n+  </body>\n+</html>\n\\ No newline at end of file\n"
